<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <RelativeLayout
        android:id="@+id/RL1"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_marginStart="10dp"
            android:layout_toStartOf="@id/btnSearch"
            android:fontFamily="@font/logo_text_bold"
            android:text="@string/kinnect"
            android:textColor="@color/SeaGreen"
            android:textSize="25sp" />

        <ImageView
            android:id="@+id/btnSearch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="50dp"
            android:background="@drawable/circle_icon"
            android:contentDescription="@string/search_icon"
            android:padding="5dp"
            android:src="@drawable/search_icon" />

        <ImageView
            android:id="@+id/messageIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="5dp"
            android:background="@drawable/circle_icon"
            android:contentDescription="@string/message_icon"
            android:padding="5dp"
            android:src="@drawable/message_circle_check" />

        <TextView
            android:id="@+id/msgBadge"
            android:layout_width="wrap_content"
            android:layout_height="12dp"
            android:layout_alignStart="@id/messageIcon"
            android:layout_marginStart="24dp"
            android:layout_marginTop="9dp"
            android:background="@drawable/badge_pill"
            android:gravity="center"
            android:minWidth="12dp"
            android:paddingStart="3dp"
            android:paddingEnd="3dp"
            android:textColor="@color/white"
            android:textSize="8sp"
            android:visibility="gone"
            tools:ignore="SmallSp" />

    </RelativeLayout>

    <LinearLayout
        android:id="@+id/LL1"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/one_sided_border_black">

        <ImageView
            android:id="@+id/tabHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/one_sided_border_seagreen"
            android:contentDescription="@string/home_icon"
            android:paddingTop="4dp"
            android:paddingBottom="17dp"
            android:src="@drawable/home" />

        <ImageView
            android:id="@+id/tabPeople"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:contentDescription="@string/people_icon"
            android:src="@drawable/people" />

        <ImageView
            android:id="@+id/tabShop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:contentDescription="@string/shop_icon"
            android:src="@drawable/shop" />

        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/tabNotif"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/notification_icon"
                android:src="@drawable/notifications" />

            <TextView
                android:id="@+id/notifBadge"
                android:layout_width="wrap_content"
                android:layout_height="15dp"
                android:layout_centerHorizontal="true"
                android:layout_marginStart="14dp"
                android:background="@drawable/badge_pill"
                android:gravity="center"
                android:minWidth="15dp"
                android:paddingStart="3dp"
                android:paddingEnd="3dp"
                android:textColor="@color/white"
                android:textSize="9sp"
                android:visibility="gone"
                tools:ignore="SmallSp" />
        </RelativeLayout>

        <ImageView
            android:id="@+id/tabMore"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:contentDescription="@string/more_icon"
            android:src="@drawable/more_symbol" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/feed"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="13dp"
    android:paddingTop="2dp"
    android:paddingEnd="12dp"
    android:paddingBottom="2dp">

    <!-- TODAY 4:49 PM -->
    <TextView
        android:id="@+id/divider"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="9dp"
        android:letterSpacing="0.03"
        android:textColor="#5E5A53"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- "Aisha took a screenshot", call logs -->
    <TextView
        android:id="@+id/systemText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_pill_gray"
        android:gravity="center"
        android:paddingStart="14dp"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp"
        android:textColor="@color/ink2"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/msgRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/avatarSlot"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginEnd="8dp">

            <com.hadisaleemi.i221043.ui.AvatarView
                android:id="@+id/msgAvatar"
                android:layout_width="30dp"
                android:layout_height="30dp" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/msgColumn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/replyLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/ink2"
                android:textSize="14sp"
                android:visibility="gone"
                tools:text="You replied to Aisha" />

            <TextView
                android:id="@+id/replyQuote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:alpha="0.75"
                android:background="@drawable/bg_bubble_in"
                android:ellipsize="end"
                android:maxLines="2"
                android:maxWidth="250dp"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="10dp"
                android:textColor="@color/ink2"
                android:textSize="15sp"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/bubbleWrap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingBottom="6dp">

                <LinearLayout
                    android:id="@+id/bubble"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/msgImage"
                        android:layout_width="211dp"
                        android:layout_height="147dp"
                        android:background="@drawable/bg_round16"
                        android:clipToOutline="true"
                        android:contentDescription="@string/photo"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/msgCaption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/ink2"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/msgText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxWidth="260dp"
                        android:minHeight="37dp"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="8dp"
                        android:textSize="16sp"
                        tools:text="Hey! Are you still coming Saturday?" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/heart"
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="10dp"
                    android:layout_marginBottom="-6dp"
                    android:background="@drawable/bg_circle"
                    android:contentDescription="@string/love"
                    android:elevation="2dp"
                    android:padding="4dp"
                    android:src="@drawable/ic_heart"
                    android:visibility="gone"
                    app:tint="#D8344F" />
            </FrameLayout>

            <TextView
                android:id="@+id/meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/ink2"
                android:textSize="11sp"
                android:visibility="gone"
                tools:text="Edited" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

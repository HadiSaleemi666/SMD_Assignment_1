<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">


    <RelativeLayout
        android:layout_marginTop="20dp"
        android:layout_width="match_parent"
        android:layout_height="64dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="4dp"
            android:padding="11dp"
            android:src="@drawable/ol_back"
            app:tint="@color/teal" />

        <RelativeLayout
            android:id="@+id/hdrAvatarBox"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="55dp">

            <com.hadisaleemi.i221043.ui.AvatarView
                android:id="@+id/hdrAvatar"
                android:layout_width="42dp"
                android:layout_height="42dp" />

            <View
                android:id="@+id/hdrDot"
                android:visibility="gone"
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentBottom="true"
                android:layout_marginEnd="-1dp"
                android:layout_marginBottom="0dp"
                android:background="@drawable/bg_online" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:layout_toEndOf="@id/hdrAvatarBox"
            android:orientation="vertical">

            <TextView
                android:id="@+id/hdrName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/ink"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/hdrStatus"
                android:text=""
                android:textColor="@color/ink2"
                android:textSize="16sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnInfo"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="8dp"
            android:padding="9dp"
            android:src="@drawable/ol_info"
            app:tint="@color/teal" />

        <ImageView
            android:id="@+id/btnVideo"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/btnInfo"
            android:layout_marginEnd="6dp"
            android:padding="9dp"
            android:src="@drawable/ol_video"
            app:tint="@color/teal" />

        <ImageView
            android:id="@+id/btnCall"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_centerVertical="true"
            android:layout_marginEnd="6dp"
            android:layout_toStartOf="@id/btnVideo"
            android:padding="9dp"
            android:src="@drawable/ol_call"
            app:tint="@color/teal" />
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line" />

    <!-- messages -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/msgList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />

            <LinearLayout
                android:id="@+id/typingRow"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="13dp">

                <com.hadisaleemi.i221043.ui.AvatarView
                    android:id="@+id/smallAvatar2"
                    android:layout_width="30dp"
                    android:layout_height="30dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_bubble_in"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <View
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:background="@drawable/bg_circle"
                        android:backgroundTint="#8B867E" />

                    <View
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:layout_marginStart="5dp"
                        android:background="@drawable/bg_circle"
                        android:backgroundTint="#A9A49C" />

                    <View
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:layout_marginStart="5dp"
                        android:background="@drawable/bg_circle"
                        android:backgroundTint="#C6C1B8" />
                </LinearLayout>
            </LinearLayout>

    <!-- Replying to ... / Cancel -->
    <LinearLayout
        android:id="@+id/replyBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/app_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/replyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/ink"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/replyText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/ink2"
                android:textSize="14sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/replyCancel"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/cancel"
            android:padding="12dp"
            android:src="@drawable/cancel_icon" />
    </LinearLayout>

    <TextView
        android:id="@+id/uploading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="4dp"
        android:text="@string/sending_photo"
        android:textColor="@color/ink2"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- composer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="7dp"
        android:paddingEnd="6dp"
        android:paddingBottom="14dp">

        <ImageView
            android:id="@+id/btnPlus"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="9dp"
            android:src="@drawable/ol_plus_circle"
            app:tint="@color/teal" />

        <ImageView
            android:id="@+id/btnCamera"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="9dp"
            android:src="@drawable/ol_camera"
            app:tint="@color/teal" />

        <ImageView
            android:id="@+id/btnGallery"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="9dp"
            android:src="@drawable/ol_image"
            app:tint="@color/teal" />

        <ImageView
            android:id="@+id/btnMic"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="9dp"
            android:src="@drawable/ol_mic"
            app:tint="@color/teal" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_gray"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="17dp"
            android:paddingEnd="10dp">

            <EditText
                android:id="@+id/etMsg"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:gravity="center_vertical"
                android:hint="Aa"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="3"
                android:textColor="@color/ink"
                android:textColorHint="#8B867E"
                android:textSize="19sp" />

            <ImageView
                android:id="@+id/btnEmoji"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:padding="2dp"
                android:src="@drawable/ol_emoji"
                app:tint="@color/teal" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnSend"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="8dp"
            android:src="@drawable/ol_thumb"
            app:tint="@color/teal" />
    </LinearLayout>
</LinearLayout>

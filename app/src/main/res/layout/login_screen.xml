<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/Porcelain">

    <!-- Top Language Selector -->
    <LinearLayout
        android:id="@+id/langSelector"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/eng_uk"
            android:textColor="@color/LightBrown" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:src="@drawable/drop_down_arrow" />
    </LinearLayout>

    <!-- App Logo -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/langSelector"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="30dp"
        android:layout_marginBottom="20dp"
        app:cardCornerRadius="25dp">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/SeaGreen"
            android:padding="8dp"
            android:src="@drawable/kinnectlogo_nobackground" />
    </androidx.cardview.widget.CardView>

    <!-- Recent Login Section (hidden dynamically when no recent login) -->
    <TextView
        android:id="@+id/text2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/cardView"
        android:layout_marginStart="20dp"
        android:layout_marginTop="10dp"
        android:text="@string/recent_login"
        android:textColor="@color/LightBrown"
        android:textStyle="bold" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cardView2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/text2"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="10dp"
        android:outlineSpotShadowColor="@color/Porcelain"
        app:cardCornerRadius="25dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="94dp">

            <com.hadisaleemi.i221043.ui.AvatarView
                android:id="@+id/pfp"
                android:layout_width="74dp"
                android:layout_height="74dp"
                android:layout_margin="10dp" />

            <TextView
                android:id="@+id/textView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_toEndOf="@+id/pfp"
                android:text="@string/jacob_west"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="45dp"
                android:layout_toEndOf="@+id/pfp"
                android:text="Tap to log in"
                android:textColor="@color/gray"
                android:textSize="12sp" />

            <ImageView
                android:layout_width="22dp"
                android:layout_height="9dp"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="40dp"
                android:src="@drawable/three_dot_icon" />
        </RelativeLayout>
    </androidx.cardview.widget.CardView>

    <!-- Email Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardView3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/cardView2"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="15dp"
        android:outlineSpotShadowColor="@color/Porcelain"
        app:cardCornerRadius="13dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="52dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="5dp"
                android:text="@string/first_login_value_title"
                android:textColor="@color/gray"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/textView2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="20dp"
                android:autofillHints="emailAddress"
                android:background="@null"
                android:hint="@string/email"
                android:importantForAutofill="yes"
                android:inputType="textEmailAddress"
                android:padding="0dp"
                android:singleLine="true"
                android:textColor="@color/black"
                android:textSize="15sp" />
        </RelativeLayout>
    </androidx.cardview.widget.CardView>

    <!-- Password Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardView4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/cardView3"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="12dp"
        android:outlineSpotShadowColor="@color/Porcelain"
        app:cardCornerRadius="13dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="52dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="5dp"
                android:text="@string/second_login_value_title"
                android:textColor="@color/gray"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/textView3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="60dp"
                android:autofillHints="password"
                android:background="@null"
                android:hint="@string/pass_encrypted"
                android:inputType="textPassword"
                android:padding="0dp"
                android:singleLine="true"
                android:textColor="@color/black"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/btnReveal"
                android:layout_width="40dp"
                android:layout_height="24dp"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="15dp"
                android:contentDescription="@string/show_password"
                android:src="@drawable/reveal_icon" />
        </RelativeLayout>
    </androidx.cardview.widget.CardView>

    <!-- Login Button -->
    <Button
        android:id="@+id/button"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_below="@id/cardView4"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/button_border_log_in"
        android:backgroundTint="@color/SeaGreen"
        android:contentDescription="@string/login_button"
        android:text="@string/log_in"
        android:textAllCaps="false"
        android:textColor="@color/white" />

    <!-- Forgot Password Link -->
    <TextView
        android:id="@+id/text4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/button"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="@string/forget_password"
        android:textColor="@color/SeaGreen"
        android:textStyle="bold" />

    <!-- Create Account Button -->
    <Button
        android:id="@+id/button2"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_below="@id/text4"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="25dp"
        android:background="@drawable/porcelain_interior_seagreen_border"
        android:contentDescription="@string/login_button"
        android:text="Create new account"
        android:textAllCaps="false"
        android:textColor="@color/SeaGreen" />

    <!-- Bottom Branding -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="20dp"
        android:gravity="center">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="match_parent"
            android:layout_toStartOf="@+id/textfinal"
            android:layout_marginEnd="6dp"
            android:src="@drawable/tiny_kinnect_logo" />

        <TextView
            android:id="@+id/textfinal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kinnect &#x2022; from SMD" />
    </RelativeLayout>

    <!-- Progress Indicator -->
    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_centerInParent="true"
        android:indeterminateTint="@color/SeaGreen"
        android:visibility="gone" />

</RelativeLayout>

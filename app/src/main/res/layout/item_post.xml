<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Author row -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="10dp"
        android:paddingTop="10dp"
        android:paddingEnd="10dp">

        <com.hadisaleemi.i221043.ui.AvatarView
            android:id="@+id/postAvatar"
            android:layout_width="45dp"
            android:layout_height="45dp" />

        <TextView
            android:id="@+id/postName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="4dp"
            android:layout_toStartOf="@id/postMore"
            android:layout_toEndOf="@id/postAvatar"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/black"
            android:textStyle="bold"
            tools:text="Lina Marsh" />

        <TextView
            android:id="@+id/postTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/postName"
            android:layout_marginStart="8dp"
            android:layout_marginTop="2dp"
            android:layout_toEndOf="@id/postAvatar"
            android:textColor="@color/black"
            android:textSize="10sp"
            tools:text="2h •" />

        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_alignTop="@id/postTime"
            android:layout_marginStart="4dp"
            android:layout_marginTop="1dp"
            android:layout_toEndOf="@id/postTime"
            android:src="@drawable/web" />

        <ImageView
            android:id="@+id/postMore"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="6dp"
            android:layout_toStartOf="@id/postHide"
            android:contentDescription="@string/more_icon"
            android:padding="4dp"
            android:src="@drawable/more_horiz_icon" />

        <ImageView
            android:id="@+id/postHide"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="6dp"
            android:contentDescription="@string/hide_post"
            android:padding="7dp"
            android:src="@drawable/cancel_icon" />
    </RelativeLayout>

    <TextView
        android:id="@+id/postText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="10dp"
        android:textColor="@color/black"
        android:textSize="15sp"
        tools:text="Sunset walk with the crew." />

    <!-- Coloured background text post (no images) -->
    <TextView
        android:id="@+id/postBgText"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:gravity="center"
        android:padding="24dp"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Multi-image grid exactly like screen 04: big photo on the left, two stacked on the
         right and a "+N" overlay on the last one. -->
    <LinearLayout
        android:id="@+id/postGrid"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/gridImg1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/LightBeige"
            android:contentDescription="@string/photo"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:id="@+id/gridRight"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="3dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/gridImg2"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@color/LightBeige"
                android:contentDescription="@string/photo"
                android:scaleType="centerCrop" />

            <FrameLayout
                android:id="@+id/gridCell3"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="3dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/gridImg3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/LightBeige"
                    android:contentDescription="@string/photo"
                    android:scaleType="centerCrop" />

                <TextView
                    android:id="@+id/gridMore"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#aa000000"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="+4" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Reaction summary: icons, who reacted, comment and share counts -->
    <LinearLayout
        android:id="@+id/reactionsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginTop="7dp"
        android:layout_marginEnd="15dp"
        android:background="@drawable/one_sided_black_border"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="7dp">

        <LinearLayout
            android:id="@+id/reactionIcons"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/reactionText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/LightBrown"
            android:textSize="13sp"
            tools:text="Aisha and 12 others" />

        <TextView
            android:id="@+id/countsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/LightBrown"
            android:textSize="13sp"
            tools:text="86 comments • 12 shares" />
    </LinearLayout>

    <!-- Like / Comment / Share -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <LinearLayout
            android:id="@+id/btnLike"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/likeimg"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/like" />

            <TextView
                android:id="@+id/likeword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/like"
                android:textColor="@color/gray"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnComment"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/commentimg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/comment" />

            <TextView
                android:id="@+id/commentword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/comment"
                android:textColor="@color/gray"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnShare"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/shareimg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/share" />

            <TextView
                android:id="@+id/shareword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/share"
                android:textColor="@color/gray"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:background="@color/LightBeige" />
</LinearLayout>
